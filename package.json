{
  "name": "gpu-perf-agent",
  "version": "1.0.0",
  "description": "Agent-ready WebGPU/WebGL2 performance profiler: Node-callable benchmark, trace, and memory reports with verdicts for automated optimization loops. Ships an agent skill.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "webgpu",
    "webgl2",
    "performance",
    "profiling",
    "benchmark",
    "gpu",
    "vram",
    "chrome-devtools-protocol",
    "cdp",
    "regression-testing",
    "agent-skill",
    "skill"
  ],
  "bin": {
    "gpu-perf-agent": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./agent": "./src/agent.js",
    "./browser/allocation-tracker": "./src/browser/allocation-tracker.js",
    "./browser/timing": "./src/browser/timing.js"
  },
  "files": [
    "src",
    "skill",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node ./src/cli.js doctor",
    "test": "node --test",
    "prepublishOnly": "node --test",
    "example:webgl2": "node ./src/cli.js run --file examples/webgl2-draw.html --samples 3 --duration-ms 600 --out reports/webgl2.json",
    "example:webgpu": "node ./src/cli.js run --file examples/webgpu-clear.html --samples 3 --duration-ms 600 --out reports/webgpu.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}